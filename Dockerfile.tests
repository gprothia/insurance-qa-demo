# Test-runner image: pytest + httpx + Playwright/Chromium. Runs as a Job inside the PR namespace.
FROM python:3.12-slim
WORKDIR /tests
COPY requirements-test.txt .
# libatomic1 is needed by Playwright's bundled Node.js; --with-deps then installs Chromium's libraries.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libatomic1 \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir --root-user-action=ignore -r requirements-test.txt \
 && playwright install --with-deps chromium
COPY pytest.ini .
COPY tests ./tests
# Run everything, then print the JUnit XML between markers so CI can pull it from the Job logs.
CMD ["sh", "-c", "pytest -v --browser chromium --junitxml=/tmp/junit.xml; rc=$?; echo '<<<JUNIT'; cat /tmp/junit.xml; echo; echo 'JUNIT>>>'; exit $rc"]
